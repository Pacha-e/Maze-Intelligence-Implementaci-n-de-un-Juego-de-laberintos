class Game {
    field Maze maze;
    field Player player;
    field Enemy enemy;
    field int state;
    field int level;
    field int mode;
    field int lives;
    field int score;
    field int moves;
    field boolean quit;

    constructor Game new() {
        let maze = null;
        let player = null;
        let enemy = null;
        let state = 0;
        let level = 1;
        let mode = 2;
        let lives = 2;
        let score = 0;
        let moves = 0;
        let quit = false;
        return this;
    }

    method void run() {
        var int key;

        do showMenu();
        while (~quit) {
            let key = Keyboard.keyPressed();

            if (state = 0) {
                do handleMenu(key);
            }
            if (state = 1) {
                do handleGameKey(key);
            }
            if (state = 2) {
                do handleEndKey(key);
            }
            if (state = 3) {
                do handleEndKey(key);
            }

            do Sys.wait(60);
        }
        return;
    }

    method void handleMenu(int key) {
        if (key = 49) {
            let mode = 1;
            let lives = 3;
            do startRun();
        }
        if (key = 50) {
            let mode = 2;
            let lives = 2;
            do startRun();
        }
        if (key = 51) {
            let mode = 3;
            let lives = 1;
            do startRun();
        }
        if ((key = 81) | (key = 113)) {
            let quit = true;
        }
        return;
    }

    method void handleGameKey(int key) {
        var int rowStep;
        var int colStep;
        var boolean moved;

        if (key = 0) {
            return;
        }

        if ((key = 81) | (key = 113)) {
            let quit = true;
            return;
        }

        if ((key = 82) | (key = 114)) {
            do startRun();
            do waitForRelease();
            return;
        }

        let rowStep = 0;
        let colStep = 0;

        if ((key = 130) | (key = 65)) {
            let colStep = -1;
        }
        if ((key = 131) | (key = 87)) {
            let rowStep = -1;
        }
        if ((key = 132) | (key = 68)) {
            let colStep = 1;
        }
        if ((key = 133) | (key = 83)) {
            let rowStep = 1;
        }

        if ((rowStep = 0) & (colStep = 0)) {
            return;
        }

        let moved = player.tryMove(rowStep, colStep, maze);
        if (moved) {
            let moves = moves + 1;
            let score = score + mode;

            if (player.isAt(maze.getGoalRow(), maze.getGoalCol())) {
                do reachGoal();
                do waitForRelease();
                return;
            }

            do moveEnemy();

            if (enemy.isAt(player.getRow(), player.getCol())) {
                do loseLife();
            } else {
                do renderGame();
            }
        }

        do waitForRelease();
        return;
    }

    method void handleEndKey(int key) {
        if ((key = 81) | (key = 113)) {
            let quit = true;
        }
        if (((key = 82) | (key = 114)) | (key = 32)) {
            do waitForRelease();
            do showMenu();
        }
        return;
    }

    method void startRun() {
        let level = 1;
        let score = 0;
        do resetLives();
        do startLevel();
        do waitForRelease();
        return;
    }

    method void resetLives() {
        if (mode = 1) {
            let lives = 3;
        }
        if (mode = 2) {
            let lives = 2;
        }
        if (mode = 3) {
            let lives = 1;
        }
        return;
    }

    method void startLevel() {
        do clearObjects();
        let maze = Maze.new(level);
        let player = Player.new(maze.getStartRow(), maze.getStartCol());
        let enemy = Enemy.new(maze.getEnemyStartRow(), maze.getEnemyStartCol(), maze.getCellCount());
        let moves = 0;
        let state = 1;
        do renderGame();
        return;
    }

    method void clearObjects() {
        if (~(maze = null)) {
            do maze.dispose();
        }
        if (~(player = null)) {
            do player.dispose();
        }
        if (~(enemy = null)) {
            do enemy.dispose();
        }
        let maze = null;
        let player = null;
        let enemy = null;
        return;
    }

    method void moveEnemy() {
        do enemy.moveToward(player, maze);
        if (mode = 3) {
            if (isMultiple(moves, 3)) {
                if (~enemy.isAt(player.getRow(), player.getCol())) {
                    do enemy.moveToward(player, maze);
                }
            }
        }
        if (mode = 1) {
            if (~isMultiple(moves, 2)) {
                do enemy.stepBack();
            }
        }
        return;
    }

    method boolean isMultiple(int value, int divisor) {
        var int quotient;
        let quotient = value / divisor;
        return value = (quotient * divisor);
    }

    method void reachGoal() {
        let score = score + ((100 * level) * mode);

        if (level = 3) {
            let state = 2;
            do showWin();
        } else {
            let level = level + 1;
            do startLevel();
        }
        return;
    }

    method void loseLife() {
        let lives = lives - 1;

        if (lives < 1) {
            let state = 3;
            do showLoss();
        } else {
            do startLevel();
        }
        return;
    }

    method void renderGame() {
        do Screen.clearScreen();
        do maze.draw();
        do player.draw(maze);
        do enemy.draw(maze);
        do drawPanel();
        return;
    }

    method void drawPanel() {
        do Output.moveCursor(0, 0);
        do Output.printString("Maze Intelligence");
        do Output.moveCursor(1, 0);
        do Output.printString("Nivel: ");
        do Output.printInt(level);
        do Output.printString("  Modo: ");
        do printMode();
        do Output.moveCursor(2, 0);
        do Output.printString("Vidas: ");
        do Output.printInt(lives);
        do Output.printString("  Puntos: ");
        do Output.printInt(score);
        do Output.moveCursor(3, 0);
        do Output.printString("Mover: WASD/flechas  R: reiniciar  Q: salir");
        return;
    }

    method void printMode() {
        if (mode = 1) {
            do Output.printString("Entrenamiento");
        }
        if (mode = 2) {
            do Output.printString("Normal");
        }
        if (mode = 3) {
            do Output.printString("Experto");
        }
        return;
    }

    method void showMenu() {
        do clearObjects();
        let state = 0;
        do Screen.clearScreen();
        do Output.moveCursor(2, 18);
        do Output.printString("Maze Intelligence");
        do Output.moveCursor(5, 8);
        do Output.printString("Llega a la salida antes de ser capturado.");
        do Output.moveCursor(8, 14);
        do Output.printString("1  Entrenamiento: 3 vidas, enemigo lento");
        do Output.moveCursor(10, 14);
        do Output.printString("2  Normal: 2 vidas, persecucion completa");
        do Output.moveCursor(12, 14);
        do Output.printString("3  Experto: 1 vida, persecucion agresiva");
        do Output.moveCursor(16, 18);
        do Output.printString("Q  Salir");
        return;
    }

    method void showWin() {
        do Screen.clearScreen();
        do Output.moveCursor(4, 22);
        do Output.printString("Escapaste");
        do Output.moveCursor(7, 18);
        do Output.printString("Puntaje final: ");
        do Output.printInt(score);
        do Output.moveCursor(11, 12);
        do Output.printString("R o espacio para volver al menu. Q para salir.");
        return;
    }

    method void showLoss() {
        do Screen.clearScreen();
        do Output.moveCursor(4, 22);
        do Output.printString("Capturado");
        do Output.moveCursor(7, 18);
        do Output.printString("Puntaje final: ");
        do Output.printInt(score);
        do Output.moveCursor(11, 12);
        do Output.printString("R o espacio para volver al menu. Q para salir.");
        return;
    }

    method void waitForRelease() {
        while (~(Keyboard.keyPressed() = 0)) {
            do Sys.wait(30);
        }
        return;
    }

    method void dispose() {
        do clearObjects();
        do Memory.deAlloc(this);
        return;
    }
}
