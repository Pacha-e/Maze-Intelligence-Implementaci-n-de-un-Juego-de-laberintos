class Player {
    field int row;
    field int col;

    constructor Player new(int startRow, int startCol) {
        let row = startRow;
        let col = startCol;
        return this;
    }

    method boolean tryMove(int rowStep, int colStep, Maze maze) {
        var int nextRow;
        var int nextCol;

        let nextRow = row + rowStep;
        let nextCol = col + colStep;

        if (maze.canEnter(nextRow, nextCol)) {
            let row = nextRow;
            let col = nextCol;
            return true;
        }
        return false;
    }

    method boolean isAt(int targetRow, int targetCol) {
        return (row = targetRow) & (col = targetCol);
    }

    method void draw(Maze maze) {
        var int x;
        var int y;

        let x = maze.cellX(col);
        let y = maze.cellY(row);
        do Screen.setColor(true);
        do Screen.drawRectangle(x + 3, y + 3, x + 10, y + 10);
        return;
    }

    method int getRow() {
        return row;
    }

    method int getCol() {
        return col;
    }

    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }
}
