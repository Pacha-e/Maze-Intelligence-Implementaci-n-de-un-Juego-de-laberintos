class Enemy {
    field int row;
    field int col;
    field int previousRow;
    field int previousCol;
    field int capacity;
    field Array queueRows;
    field Array queueCols;
    field Array firstRows;
    field Array firstCols;
    field Array visited;

    constructor Enemy new(int startRow, int startCol, int maxCells) {
        let row = startRow;
        let col = startCol;
        let previousRow = startRow;
        let previousCol = startCol;
        let capacity = maxCells;
        let queueRows = Array.new(capacity);
        let queueCols = Array.new(capacity);
        let firstRows = Array.new(capacity);
        let firstCols = Array.new(capacity);
        let visited = Array.new(capacity);
        return this;
    }

    method void moveToward(Player player, Maze maze) {
        var int front;
        var int back;
        var int currentRow;
        var int currentCol;
        var int targetRow;
        var int targetCol;
        var int foundAt;

        let previousRow = row;
        let previousCol = col;
        let targetRow = player.getRow();
        let targetCol = player.getCol();

        do clearVisited();

        let front = 0;
        let back = 0;
        let foundAt = -1;

        let queueRows[back] = row;
        let queueCols[back] = col;
        let firstRows[back] = row;
        let firstCols[back] = col;
        do markVisited(row, col, maze);
        let back = back + 1;

        while ((front < back) & (foundAt < 0)) {
            let currentRow = queueRows[front];
            let currentCol = queueCols[front];

            if ((currentRow = targetRow) & (currentCol = targetCol)) {
                let foundAt = front;
            } else {
                let back = addNeighbor(currentRow, currentCol, currentRow - 1, currentCol, front, back, maze);
                let back = addNeighbor(currentRow, currentCol, currentRow + 1, currentCol, front, back, maze);
                let back = addNeighbor(currentRow, currentCol, currentRow, currentCol - 1, front, back, maze);
                let back = addNeighbor(currentRow, currentCol, currentRow, currentCol + 1, front, back, maze);
            }
            let front = front + 1;
        }

        if (foundAt < 0) {
            do greedyMove(player, maze);
        } else {
            let row = firstRows[foundAt];
            let col = firstCols[foundAt];
        }
        return;
    }

    method int addNeighbor(int baseRow, int baseCol, int nextRow, int nextCol, int baseIndex, int back, Maze maze) {
        if (back < capacity) {
            if (maze.canEnter(nextRow, nextCol)) {
                if (~isVisited(nextRow, nextCol, maze)) {
                    let queueRows[back] = nextRow;
                    let queueCols[back] = nextCol;

                    if ((baseRow = row) & (baseCol = col)) {
                        let firstRows[back] = nextRow;
                        let firstCols[back] = nextCol;
                    } else {
                        let firstRows[back] = firstRows[baseIndex];
                        let firstCols[back] = firstCols[baseIndex];
                    }

                    do markVisited(nextRow, nextCol, maze);
                    let back = back + 1;
                }
            }
        }
        return back;
    }

    method void greedyMove(Player player, Maze maze) {
        var int bestRow;
        var int bestCol;
        var int bestDistance;

        let bestRow = row;
        let bestCol = col;
        let bestDistance = distance(row, col, player.getRow(), player.getCol());

        do chooseGreedy(row - 1, col, player, maze);
        if (distance(row, col, player.getRow(), player.getCol()) < bestDistance) {
            let bestRow = row;
            let bestCol = col;
            let bestDistance = distance(row, col, player.getRow(), player.getCol());
        }

        let row = previousRow;
        let col = previousCol;
        do chooseGreedy(row + 1, col, player, maze);
        if (distance(row, col, player.getRow(), player.getCol()) < bestDistance) {
            let bestRow = row;
            let bestCol = col;
            let bestDistance = distance(row, col, player.getRow(), player.getCol());
        }

        let row = previousRow;
        let col = previousCol;
        do chooseGreedy(row, col - 1, player, maze);
        if (distance(row, col, player.getRow(), player.getCol()) < bestDistance) {
            let bestRow = row;
            let bestCol = col;
            let bestDistance = distance(row, col, player.getRow(), player.getCol());
        }

        let row = previousRow;
        let col = previousCol;
        do chooseGreedy(row, col + 1, player, maze);
        if (distance(row, col, player.getRow(), player.getCol()) < bestDistance) {
            let bestRow = row;
            let bestCol = col;
        }

        let row = bestRow;
        let col = bestCol;
        return;
    }

    method void chooseGreedy(int nextRow, int nextCol, Player player, Maze maze) {
        if (maze.canEnter(nextRow, nextCol)) {
            let row = nextRow;
            let col = nextCol;
        }
        return;
    }

    method void clearVisited() {
        var int index;

        let index = 0;
        while (index < capacity) {
            let visited[index] = 0;
            let index = index + 1;
        }
        return;
    }

    method boolean isVisited(int targetRow, int targetCol, Maze maze) {
        var int index;
        let index = maze.getIndex(targetRow, targetCol);
        return visited[index] = 1;
    }

    method void markVisited(int targetRow, int targetCol, Maze maze) {
        var int index;
        let index = maze.getIndex(targetRow, targetCol);
        let visited[index] = 1;
        return;
    }

    method int distance(int firstRow, int firstCol, int secondRow, int secondCol) {
        return abs(firstRow - secondRow) + abs(firstCol - secondCol);
    }

    method int abs(int value) {
        if (value < 0) {
            return -value;
        }
        return value;
    }

    method void stepBack() {
        let row = previousRow;
        let col = previousCol;
        return;
    }

    method boolean isAt(int targetRow, int targetCol) {
        return (row = targetRow) & (col = targetCol);
    }

    method void draw(Maze maze) {
        var int x;
        var int y;

        let x = maze.cellX(col);
        let y = maze.cellY(row);
        do Screen.setColor(true);
        do Screen.drawRectangle(x + 2, y + 2, x + 11, y + 11);
        do Screen.setColor(false);
        do Screen.drawRectangle(x + 5, y + 5, x + 8, y + 8);
        return;
    }

    method int getRow() {
        return row;
    }

    method int getCol() {
        return col;
    }

    method void dispose() {
        do queueRows.dispose();
        do queueCols.dispose();
        do firstRows.dispose();
        do firstCols.dispose();
        do visited.dispose();
        do Memory.deAlloc(this);
        return;
    }
}
