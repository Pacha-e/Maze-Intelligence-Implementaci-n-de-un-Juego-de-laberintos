// Enemigo perseguidor.
// Heuristica: distancia Manhattan al jugador con filtro de muros.
// Mantiene una frontera de celdas alcanzables y en cada paso elige la
// mas cercana al jugador. Si en 150 expansiones no llega, da un paso
// voraz hacia el vecino transitable mas cercano.
class Enemigo {
    field int fila, col;
    field int filaAnt, colAnt;
    field int capacidad;
    field int variante;

    field Array colaF, colaC;
    field Array primeraF, primeraC;
    field Array visitado;

    constructor Enemigo new(int max) {
        let capacidad = max;
        let colaF = Array.new(capacidad);
        let colaC = Array.new(capacidad);
        let primeraF = Array.new(capacidad);
        let primeraC = Array.new(capacidad);
        let visitado = Array.new(capacidad);
        let fila = 0;
        let col = 0;
        let filaAnt = 0;
        let colAnt = 0;
        let variante = 1;
        return this;
    }

    method void setVariante(int v) { let variante = v; return; }

    method void fijar(int f, int c) {
        let fila = f;
        let col = c;
        let filaAnt = f;
        let colAnt = c;
        return;
    }

    method void moverHacia(Jugador jug, Laberinto lab) {
        do moverEvitando(jug, lab, -1, -1);
        return;
    }

    // ef, ec: posicion del companero (modo Experto). -1,-1 si no hay.
    method void moverEvitando(Jugador jug, Laberinto lab, int ef, int ec) {
        var int frente, final, fAct, cAct, fObj, cObj, mejorI, i;
        var int dMin, dAct;

        let filaAnt = fila;
        let colAnt = col;
        let fObj = jug.getFila();
        let cObj = jug.getCol();

        do limpiarVisitados();
        let frente = 0;
        let final = 0;

        let colaF[final] = fila;
        let colaC[final] = col;
        let primeraF[final] = fila;
        let primeraC[final] = col;
        let visitado[lab.getIndice(fila, col)] = 1;

        if ((ef > -1) & (ec > -1)) {
            let visitado[lab.getIndice(ef, ec)] = 1;
        }
        let final = final + 1;

        while ((frente < final) & (frente < 150)) {
            let mejorI = frente;
            let dMin = 10000;
            let i = frente;
            while (i < final) {
                let dAct = distancia(colaF[i], colaC[i], fObj, cObj);
                if (dAct < dMin) {
                    let dMin = dAct;
                    let mejorI = i;
                }
                let i = i + 1;
            }
            do intercambiar(frente, mejorI);

            let fAct = colaF[frente];
            let cAct = colaC[frente];

            if ((fAct = fObj) & (cAct = cObj)) {
                let fila = primeraF[frente];
                let col = primeraC[frente];
                return;
            }

            let final = expandir(fAct - 1, cAct, frente, final, lab);
            let final = expandir(fAct + 1, cAct, frente, final, lab);
            let final = expandir(fAct, cAct - 1, frente, final, lab);
            let final = expandir(fAct, cAct + 1, frente, final, lab);
            let frente = frente + 1;
        }
        do pasoVoraz(fObj, cObj, lab, ef, ec);
        return;
    }

    method void limpiarVisitados() {
        var int i;
        let i = 0;
        while (i < capacidad) {
            let visitado[i] = 0;
            let i = i + 1;
        }
        return;
    }

    method void pasoVoraz(int fObj, int cObj, Laberinto lab, int ef, int ec) {
        var int mejorF, mejorC, mejorD, d;
        let mejorF = fila;
        let mejorC = col;
        let mejorD = distancia(fila, col, fObj, cObj);
        if (vecinoValido(fila - 1, col, lab, ef, ec)) {
            let d = distancia(fila - 1, col, fObj, cObj);
            if (d < mejorD) { let mejorD = d; let mejorF = fila - 1; let mejorC = col; }
        }
        if (vecinoValido(fila + 1, col, lab, ef, ec)) {
            let d = distancia(fila + 1, col, fObj, cObj);
            if (d < mejorD) { let mejorD = d; let mejorF = fila + 1; let mejorC = col; }
        }
        if (vecinoValido(fila, col - 1, lab, ef, ec)) {
            let d = distancia(fila, col - 1, fObj, cObj);
            if (d < mejorD) { let mejorD = d; let mejorF = fila; let mejorC = col - 1; }
        }
        if (vecinoValido(fila, col + 1, lab, ef, ec)) {
            let d = distancia(fila, col + 1, fObj, cObj);
            if (d < mejorD) { let mejorD = d; let mejorF = fila; let mejorC = col + 1; }
        }
        let fila = mejorF;
        let col = mejorC;
        return;
    }

    method boolean vecinoValido(int f, int c, Laberinto lab, int ef, int ec) {
        if (~lab.puedeEntrar(f, c)) { return false; }
        if ((f = ef) & (c = ec)) { return false; }
        return true;
    }

    method int expandir(int nf, int nc, int bI, int fin, Laberinto lab) {
        var int idx;
        if (~(fin < capacidad)) { return fin; }
        if (~lab.puedeEntrar(nf, nc)) { return fin; }
        let idx = lab.getIndice(nf, nc);
        if (~(visitado[idx] = 0)) { return fin; }
        let colaF[fin] = nf;
        let colaC[fin] = nc;
        let visitado[idx] = 1;
        if ((colaF[bI] = filaAnt) & (colaC[bI] = colAnt)) {
            let primeraF[fin] = nf;
            let primeraC[fin] = nc;
        } else {
            let primeraF[fin] = primeraF[bI];
            let primeraC[fin] = primeraC[bI];
        }
        return fin + 1;
    }

    method void intercambiar(int a, int b) {
        var int tf, tc, pf, pc;
        if (a = b) { return; }
        let tf = colaF[a];
        let tc = colaC[a];
        let pf = primeraF[a];
        let pc = primeraC[a];
        let colaF[a] = colaF[b];
        let colaC[a] = colaC[b];
        let primeraF[a] = primeraF[b];
        let primeraC[a] = primeraC[b];
        let colaF[b] = tf;
        let colaC[b] = tc;
        let primeraF[b] = pf;
        let primeraC[b] = pc;
        return;
    }

    method int distancia(int f1, int c1, int f2, int c2) {
        var int df, dc;
        let df = f1 - f2;
        let dc = c1 - c2;
        if (df < 0) { let df = -df; }
        if (dc < 0) { let dc = -dc; }
        return df + dc;
    }

    method void retroceder() {
        let fila = filaAnt;
        let col = colAnt;
        return;
    }

    method boolean estaEn(int f, int c) { return (fila = f) & (col = c); }

    method void dibujar(Laberinto lab) {
        var int x, y;
        let x = lab.celdaX(col);
        let y = lab.celdaY(fila);
        do Screen.setColor(true);
        do Screen.drawRectangle(x + 2, y + 4, x + 13, y + 12);
        do Screen.drawCircle(x + 7, y + 5, 4);
        do Screen.setColor(false);
        do dibujarOndas(x, y);
        do Screen.drawRectangle(x + 4, y + 6, x + 6, y + 8);
        do Screen.drawRectangle(x + 9, y + 6, x + 11, y + 8);
        do Screen.setColor(true);
        if (variante = 2) {
            do dibujarPupilasRasgadas(x, y);
        } else {
            do dibujarPupilasCentinela(x, y);
        }
        return;
    }

    method void dibujarOndas(int x, int y) {
        do Screen.drawLine(x + 3, y + 12, x + 4, y + 13);
        do Screen.drawLine(x + 4, y + 13, x + 5, y + 12);
        do Screen.drawLine(x + 6, y + 12, x + 7, y + 13);
        do Screen.drawLine(x + 7, y + 13, x + 8, y + 12);
        do Screen.drawLine(x + 9, y + 12, x + 10, y + 13);
        do Screen.drawLine(x + 10, y + 13, x + 11, y + 12);
        return;
    }

    method void dibujarPupilasCentinela(int x, int y) {
        do Screen.drawRectangle(x + 5, y + 7, x + 6, y + 8);
        do Screen.drawRectangle(x + 9, y + 7, x + 10, y + 8);
        return;
    }

    method void dibujarPupilasRasgadas(int x, int y) {
        do Screen.drawRectangle(x + 5, y + 6, x + 5, y + 8);
        do Screen.drawRectangle(x + 10, y + 6, x + 10, y + 8);
        do Screen.drawLine(x + 7, y, x + 7, y + 2);
        return;
    }

    method int getFila() { return fila; }
    method int getCol() { return col; }

    method void eliminar() {
        do Memory.deAlloc(colaF);
        do Memory.deAlloc(colaC);
        do Memory.deAlloc(primeraF);
        do Memory.deAlloc(primeraC);
        do Memory.deAlloc(visitado);
        do Memory.deAlloc(this);
        return;
    }
}
