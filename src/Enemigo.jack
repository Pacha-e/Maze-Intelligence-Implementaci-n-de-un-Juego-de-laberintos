/** IA del enemigo: heuristica Manhattan con conciencia de muros.
 *
 *  El enemigo no usa BFS ni A*. Mantiene una frontera de celdas candidatas
 *  y en cada iteracion elige la celda con menor distancia Manhattan al
 *  jugador. La "conciencia de muros" viene del chequeo lab.puedeEntrar
 *  antes de agregar cualquier vecino a la frontera: las celdas con muro
 *  o fuera de bordes nunca entran. Asi el enemigo rodea obstaculos sin
 *  necesidad de reconstruir el camino completo.
 *
 *  Variante moverEvitando(ef, ec): en modo Experto, el segundo enemigo
 *  recibe la posicion del primero (ef, ec) y la marca como visitada antes
 *  de empezar; el segundo enemigo entonces evita esa celda al planear su
 *  paso, lo que evita que ambos se fusionen y produce una pinza tactica.
 *  Sentinela (-1, -1) significa "sin companero".
 */
class Enemigo {
    field int fila, col;
    field int filaAnt, colAnt;
    field int capacidad;
    
    // Estructuras de la heuristica Manhattan con conciencia de muros
    field Array colaF, colaC;       // Frontera de exploracion (Filas y Columnas)
    field Array primeraF, primeraC; // Rastro del primer movimiento realizado
    field Array visitado;           // Registro para evitar ciclos y muros

    constructor Enemigo new(int max) {
        let capacidad = max;
        // Pre-alocacion de memoria para la busqueda mental
        let colaF = Array.new(capacidad);
        let colaC = Array.new(capacidad);
        let primeraF = Array.new(capacidad);
        let primeraC = Array.new(capacidad);
        let visitado = Array.new(capacidad);
        
        let fila = 0; let col = 0;
        let filaAnt = 0; let colAnt = 0;
        return this;
    }

    method void fijar(int f, int c) {
        let fila = f; let col = c;
        let filaAnt = f; let colAnt = c;
        return;
    }

    method void moverHacia(Jugador jug, Laberinto lab) {
        do moverEvitando(jug, lab, -1, -1);
        return;
    }

    /** Heuristica Manhattan con conciencia de muros: en cada iteracion
     *  selecciona de la frontera la celda con menor distancia Manhattan
     *  al jugador, y solo expande vecinos que pasen lab.puedeEntrar.
     *  Esto rodea muros y bordes sin construir el camino completo.
     */
    method void moverEvitando(Jugador jug, Laberinto lab, int ef, int ec) {
        var int frente, final, fAct, cAct, fObj, cObj, mejorI, i;
        var int dMin, dAct;
        
        let filaAnt = fila; let colAnt = col;
        let fObj = jug.getFila(); let cObj = jug.getCol();
        
        // 1. Limpiar estado de busqueda
        let i = 0;
        while (i < capacidad) { let visitado[i] = 0; let i = i + 1; }
        let frente = 0; let final = 0;

        // 2. Inicializar frontera con la posicion actual
        let colaF[final] = fila; 
        let colaC[final] = col;
        let primeraF[final] = fila; 
        let primeraC[final] = col;
        let visitado[lab.getIndice(fila, col)] = 1;
        
        // Marcar posicion del otro enemigo como muro temporal (Sombra Tactica).
        // Usamos (-1, -1) como sentinela "sin compañero": tratamos (>= 0) como valido.
        if ((ef > -1) & (ec > -1)) {
            let visitado[lab.getIndice(ef, ec)] = 1;
        }
        let final = final + 1;

        // 3. Bucle principal: tope de 150 expansiones para mantener fluidez en la VM
        while ((frente < final) & (frente < 150)) {

            // Selecciona el nodo de la frontera con menor distancia Manhattan al jugador
            let mejorI = frente;
            let dMin = 10000;
            let i = frente;
            while (i < final) {
                let dAct = distancia(colaF[i], colaC[i], fObj, cObj);
                if (dAct < dMin) {
                    let dMin = dAct;
                    let mejorI = i;
                }
                let i = i + 1;
            }
            // Intercambiar el mejor al frente para procesarlo
            do intercambiar(frente, mejorI);
            
            let fAct = colaF[frente]; 
            let cAct = colaC[frente];

            // ¿Llegamos al jugador en nuestra simulacion?
            if ((fAct = fObj) & (cAct = cObj)) {
                let fila = primeraF[frente];
                let col = primeraC[frente];
                return; // Encontramos el camino
            }

            // Expandir vecinos
            let final = expandir(fAct - 1, cAct, frente, final, lab); // Arriba
            let final = expandir(fAct + 1, cAct, frente, final, lab); // Abajo
            let final = expandir(fAct, cAct - 1, frente, final, lab); // Izquierda
            let final = expandir(fAct, cAct + 1, frente, final, lab); // Derecha

            let frente = frente + 1;
        }

        // Si no hay camino claro, mantener posicion o movimiento simple
        return;
    }

    method int expandir(int nf, int nc, int bI, int fin, Laberinto lab) {
        var int idx;
        if (fin < capacidad) {
            if (lab.puedeEntrar(nf, nc)) {
                let idx = lab.getIndice(nf, nc);
                if (visitado[idx] = 0) {
                    let colaF[fin] = nf;
                    let colaC[fin] = nc;
                    let visitado[idx] = 1;
                    
                    // Si es el primer paso desde el origen, guardar esta direccion
                    if ((colaF[bI] = filaAnt) & (colaC[bI] = colAnt)) {
                        let primeraF[fin] = nf;
                        let primeraC[fin] = nc;
                    } else {
                        // Heredar la direccion del padre
                        let primeraF[fin] = primeraF[bI];
                        let primeraC[fin] = primeraC[bI];
                    }
                    let fin = fin + 1;
                }
            }
        }
        return fin;
    }

    method void intercambiar(int a, int b) {
        var int tf, tc, pf, pc;
        if (a = b) { return; }
        let tf = colaF[a]; let tc = colaC[a];
        let pf = primeraF[a]; let pc = primeraC[a];
        
        let colaF[a] = colaF[b]; let colaC[a] = colaC[b];
        let primeraF[a] = primeraF[b]; let primeraC[a] = primeraC[b];
        
        let colaF[b] = tf; let colaC[b] = tc;
        let primeraF[b] = pf; let primeraC[b] = pc;
        return;
    }

    method int distancia(int f1, int c1, int f2, int c2) {
        var int df, dc;
        let df = f1 - f2; let dc = c1 - c2;
        if (df < 0) { let df = -df; }
        if (dc < 0) { let dc = -dc; }
        return df + dc;
    }

    method void retroceder() { let fila = filaAnt; let col = colAnt; return; }
    method boolean estaEn(int f, int c) { return (fila = f) & (col = c); }

    method void dibujar(Laberinto lab) {
        var int x, y;
        let x = lab.celdaX(col); let y = lab.celdaY(fila);
        do Screen.setColor(true);
        do Screen.drawRectangle(x + 2, y + 2, x + 11, y + 11);
        do Screen.setColor(false);
        do Screen.drawRectangle(x + 5, y + 5, x + 8, y + 8);
        return;
    }

    method int getFila() { return fila; }
    method int getCol() { return col; }

    method void eliminar() {
        do Memory.deAlloc(colaF);
        do Memory.deAlloc(colaC);
        do Memory.deAlloc(primeraF);
        do Memory.deAlloc(primeraC);
        do Memory.deAlloc(visitado);
        do Memory.deAlloc(this);
        return;
    }
}
