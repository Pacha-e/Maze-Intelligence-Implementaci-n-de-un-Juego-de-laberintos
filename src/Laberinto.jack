/** Estructura del laberinto y gestion de objetivos.
 *  Pre-alocado con dimensiones MAXIMAS (filasMax x colsMax) y un pool de
 *  Objetivos. reiniciar(f, c) cambia las dimensiones logicas y vacia el
 *  estado sin disparar Memory.alloc/deAlloc -- evita la fragmentacion del
 *  heap JackOS entre niveles y muertes.
 */
class Laberinto {
    field Array celdas;
    field int filas, cols;
    field int filasMax, colsMax;
    field int filaInicio, colInicio;
    field int filaEnemigoInicio, colEnemigoInicio;
    field int filaEnemigo2Inicio, colEnemigo2Inicio;
    field Array objetivos;
    field int conteoObjetivos;
    field int capacidadObjetivos;

    constructor Laberinto new(int maxF, int maxC) {
        var int i;
        let filasMax = maxF;
        let colsMax = maxC;
        let filas = maxF;
        let cols = maxC;
        let celdas = Array.new(maxF * maxC);
        let capacidadObjetivos = 30;
        let objetivos = Array.new(capacidadObjetivos);
        // Pool de Objetivos pre-alocado: nunca se desaloca por nivel.
        let i = 0;
        while (i < capacidadObjetivos) {
            let objetivos[i] = Objetivo.new(0, 0);
            let i = i + 1;
        }
        let conteoObjetivos = 0;
        do vaciar();
        return this;
    }

    /** Reinicia el laberinto con nuevas dimensiones logicas, sin alocar. */
    method void reiniciar(int f, int c) {
        let filas = f;
        let cols = c;
        let conteoObjetivos = 0;
        let filaInicio = 0;
        let colInicio = 0;
        let filaEnemigoInicio = 0;
        let colEnemigoInicio = 0;
        let filaEnemigo2Inicio = 0;
        let colEnemigo2Inicio = 0;
        do vaciar();
        return;
    }

    method void vaciar() {
        var int i, total;
        let i = 0;
        let total = filasMax * colsMax;
        while (i < total) {
            let celdas[i] = 0;
            let i = i + 1;
        }
        return;
    }

    method void construirBorde() {
        var int f, c;
        let c = 0;
        while (c < cols) {
            do setMuro(0, c);
            do setMuro(filas - 1, c);
            let c = c + 1;
        }
        let f = 0;
        while (f < filas) {
            do setMuro(f, 0);
            do setMuro(f, cols - 1);
            let f = f + 1;
        }
        return;
    }

    method void filaMuro(int f, int c1, int c2, int hueco) {
        var int c;
        let c = c1;
        while (~(c > c2)) {
            if (~(c = hueco)) { do setMuro(f, c); }
            let c = c + 1;
        }
        return;
    }

    method void colMuro(int c, int f1, int f2, int hueco) {
        var int f;
        let f = f1;
        while (~(f > f2)) {
            if (~(f = hueco)) { do setMuro(f, c); }
            let f = f + 1;
        }
        return;
    }

    method void setMuro(int f, int c) {
        let celdas[(f * colsMax) + c] = 1;
        return;
    }

    /** Borra un muro en la posicion especificada. */
    method void reiniciarCelda(int f, int c) {
        let celdas[(f * colsMax) + c] = 0;
        return;
    }

    /** Reposiciona un Objetivo del pool sin alocar.
     *  Guarda defensiva: descarta silenciosamente posiciones invalidas
     *  (muro o fuera del grid) para que un mapa mal definido nunca
     *  produzca una galleta inalcanzable que congele el nivel.
     */
    method void setObjetivo(int f, int c) {
        var Objetivo obj;
        if (~puedeEntrar(f, c)) { return; }
        if (conteoObjetivos < capacidadObjetivos) {
            let obj = objetivos[conteoObjetivos];
            do obj.fijar(f, c);
            let conteoObjetivos = conteoObjetivos + 1;
        }
        return;
    }

    /** Elimina un objetivo logicamente: swap-with-last preserva el pool. */
    method void removerObjetivo(int f, int c) {
        var int i;
        var Objetivo obj, tmp;
        let i = 0;
        while (i < conteoObjetivos) {
            let obj = objetivos[i];
            if ((obj.getFila() = f) & (obj.getCol() = c)) {
                let tmp = objetivos[conteoObjetivos - 1];
                let objetivos[conteoObjetivos - 1] = obj;
                let objetivos[i] = tmp;
                let conteoObjetivos = conteoObjetivos - 1;
                return;
            }
            let i = i + 1;
        }
        return;
    }

    method boolean puedeEntrar(int f, int c) {
        if ((f < 0) | (c < 0) | (~(f < filas)) | (~(c < cols))) { return false; }
        return ~(celdas[(f * colsMax) + c] = 1);
    }

    method void dibujar() {
        var int f, c, x, y, i;
        var Objetivo obj;
        let f = 0; let y = 42;
        while (f < filas) {
            let c = 0; let x = 10;
            while (c < cols) {
                if (celdas[(f * colsMax) + c] = 1) {
                    do Screen.setColor(true);
                    do Screen.drawRectangle(x, y, x + 13, y + 13);
                }
                let c = c + 1; let x = x + 16;
            }
            let f = f + 1; let y = y + 16;
        }
        let i = 0;
        while (i < conteoObjetivos) {
            let obj = objetivos[i];
            let x = celdaX(obj.getCol());
            let y = celdaY(obj.getFila());
            do Screen.setColor(true);
            do Screen.drawRectangle(x + 4, y + 4, x + 9, y + 9);
            let i = i + 1;
        }
        return;
    }

    method int celdaX(int c) { return 10 + (c * 16); }
    method int celdaY(int f) { return 42 + (f * 16); }
    method int getFilaInicio() { return filaInicio; }
    method int getColInicio() { return colInicio; }
    method int getFilaEnemigoInicio() { return filaEnemigoInicio; }
    method int getColEnemigoInicio() { return colEnemigoInicio; }
    method int getFilaEnemigo2Inicio() { return filaEnemigo2Inicio; }
    method int getColEnemigo2Inicio() { return colEnemigo2Inicio; }
    method int getConteoCeldas() { return filas * cols; }
    method int getConteoObjetivos() { return conteoObjetivos; }
    method int getFilaObjetivo(int i) { var Objetivo o; let o = objetivos[i]; return o.getFila(); }
    method int getColObjetivo(int i) { var Objetivo o; let o = objetivos[i]; return o.getCol(); }
    method int getIndice(int f, int c) { return (f * colsMax) + c; }
    /** Setters de posiciones iniciales con guarda defensiva:
     *  si la coordenada cae en muro o fuera del grid, se descarta para
     *  evitar que el jugador o el enemigo arranquen en una celda ilegal.
     */
    method void setInicio(int f, int c) {
        if (~puedeEntrar(f, c)) { return; }
        let filaInicio = f; let colInicio = c;
        return;
    }
    method void setEnemigoInicio(int f, int c) {
        if (~puedeEntrar(f, c)) { return; }
        let filaEnemigoInicio = f; let colEnemigoInicio = c;
        return;
    }
    method void setEnemigo2Inicio(int f, int c) {
        if (~puedeEntrar(f, c)) { return; }
        let filaEnemigo2Inicio = f; let colEnemigo2Inicio = c;
        return;
    }

    method void eliminar() {
        var int i;
        var Objetivo obj;
        let i = 0;
        while (i < capacidadObjetivos) {
            let obj = objetivos[i];
            if (~(obj = null)) { do obj.eliminar(); }
            let i = i + 1;
        }
        do Memory.deAlloc(objetivos);
        do Memory.deAlloc(celdas);
        do Memory.deAlloc(this);
        return;
    }
}
