class Maze {
    field Array cells;
    field int rows;
    field int cols;
    field int level;
    field int startRow;
    field int startCol;
    field int enemyStartRow;
    field int enemyStartCol;
    field int goalRow;
    field int goalCol;

    constructor Maze new(int selectedLevel) {
        let rows = 12;
        let cols = 16;
        let level = selectedLevel;
        let cells = Array.new(rows * cols);
        do build();
        return this;
    }

    method void build() {
        var int row;
        var int col;

        let row = 0;
        while (row < rows) {
            let col = 0;
            while (col < cols) {
                do setCell(row, col, 0);
                let col = col + 1;
            }
            let row = row + 1;
        }

        do buildBorder();

        if (level = 1) {
            do buildLevelOne();
        }
        if (level = 2) {
            do buildLevelTwo();
        }
        if (level = 3) {
            do buildLevelThree();
        }

        do setCell(goalRow, goalCol, 2);
        return;
    }

    method void buildBorder() {
        var int row;
        var int col;

        let col = 0;
        while (col < cols) {
            do setWall(0, col);
            do setWall(rows - 1, col);
            let col = col + 1;
        }

        let row = 0;
        while (row < rows) {
            do setWall(row, 0);
            do setWall(row, cols - 1);
            let row = row + 1;
        }
        return;
    }

    method void buildLevelOne() {
        do wallRow(3, 2, 13, 7);
        do wallRow(6, 1, 10, 4);
        do wallCol(5, 4, 10, 8);
        do wallCol(11, 1, 8, 5);

        let startRow = 1;
        let startCol = 1;
        let enemyStartRow = 10;
        let enemyStartCol = 1;
        let goalRow = 10;
        let goalCol = 14;
        return;
    }

    method void buildLevelTwo() {
        do wallRow(2, 2, 13, 11);
        do wallRow(4, 1, 12, 4);
        do wallRow(6, 3, 13, 8);
        do wallRow(8, 5, 14, 12);
        do wallCol(6, 2, 9, 5);
        do wallCol(11, 1, 8, 7);

        let startRow = 10;
        let startCol = 1;
        let enemyStartRow = 10;
        let enemyStartCol = 14;
        let goalRow = 1;
        let goalCol = 14;
        return;
    }

    method void buildLevelThree() {
        do wallRow(2, 1, 12, 6);
        do wallRow(4, 3, 14, 12);
        do wallRow(6, 1, 11, 2);
        do wallRow(8, 4, 13, 9);
        do wallCol(5, 2, 10, 7);
        do wallCol(10, 1, 8, 3);

        let startRow = 1;
        let startCol = 14;
        let enemyStartRow = 1;
        let enemyStartCol = 1;
        let goalRow = 10;
        let goalCol = 1;
        return;
    }

    method void wallRow(int row, int firstCol, int lastCol, int gapCol) {
        var int col;

        let col = firstCol;
        while (~(col > lastCol)) {
            if (~(col = gapCol)) {
                do setWall(row, col);
            }
            let col = col + 1;
        }
        return;
    }

    method void wallCol(int col, int firstRow, int lastRow, int gapRow) {
        var int row;

        let row = firstRow;
        while (~(row > lastRow)) {
            if (~(row = gapRow)) {
                do setWall(row, col);
            }
            let row = row + 1;
        }
        return;
    }

    method void setWall(int row, int col) {
        do setCell(row, col, 1);
        return;
    }

    method void setCell(int row, int col, int value) {
        var int index;
        let index = getIndex(row, col);
        let cells[index] = value;
        return;
    }

    method int getCell(int row, int col) {
        var int index;
        let index = getIndex(row, col);
        return cells[index];
    }

    method int getIndex(int row, int col) {
        return (row * cols) + col;
    }

    method boolean canEnter(int row, int col) {
        if (row < 0) {
            return false;
        }
        if (col < 0) {
            return false;
        }
        if (~(row < rows)) {
            return false;
        }
        if (~(col < cols)) {
            return false;
        }
        if (getCell(row, col) = 1) {
            return false;
        }
        return true;
    }

    method void draw() {
        var int row;
        var int col;

        let row = 0;
        while (row < rows) {
            let col = 0;
            while (col < cols) {
                do drawCell(row, col);
                let col = col + 1;
            }
            let row = row + 1;
        }
        return;
    }

    method void drawCell(int row, int col) {
        var int x;
        var int y;
        var int value;

        let x = cellX(col);
        let y = cellY(row);
        let value = getCell(row, col);

        do Screen.setColor(false);
        do Screen.drawRectangle(x, y, x + 13, y + 13);

        if (value = 1) {
            do Screen.setColor(true);
            do Screen.drawRectangle(x, y, x + 13, y + 13);
        }

        if (value = 2) {
            do Screen.setColor(true);
            do Screen.drawRectangle(x + 4, y + 4, x + 9, y + 9);
            do Screen.drawRectangle(x + 6, y + 1, x + 7, y + 12);
            do Screen.drawRectangle(x + 1, y + 6, x + 12, y + 7);
        }
        return;
    }

    method int cellX(int col) {
        return 8 + (col * 14);
    }

    method int cellY(int row) {
        return 38 + (row * 14);
    }

    method int getRows() {
        return rows;
    }

    method int getCols() {
        return cols;
    }

    method int getCellCount() {
        return rows * cols;
    }

    method int getStartRow() {
        return startRow;
    }

    method int getStartCol() {
        return startCol;
    }

    method int getEnemyStartRow() {
        return enemyStartRow;
    }

    method int getEnemyStartCol() {
        return enemyStartCol;
    }

    method int getGoalRow() {
        return goalRow;
    }

    method int getGoalCol() {
        return goalCol;
    }

    method void dispose() {
        do cells.dispose();
        do Memory.deAlloc(this);
        return;
    }
}
