class Maze {
    field Array cells;
    field int rows;
    field int cols;
    field int level;
    field int startRow;
    field int startCol;
    field int enemyStartRow;
    field int enemyStartCol;
    field int goalRow;
    field int goalCol;

    constructor Maze new(int selectedLevel) {
        let rows = 10;
        let cols = 12;
        let level = selectedLevel;
        let cells = Array.new(rows * cols);
        do build();
        return this;
    }

    method void build() {
        var int index;
        var int total;

        let index = 0;
        let total = rows * cols;
        while (index < total) {
            let cells[index] = 0;
            let index = index + 1;
        }

        do buildBorder();

        if (level = 1) {
            do buildLevelOne();
        }
        if (level = 2) {
            do buildLevelTwo();
        }
        if (level = 3) {
            do buildLevelThree();
        }

        do setCell(goalRow, goalCol, 2);
        return;
    }

    method void buildBorder() {
        var int row;
        var int col;

        let col = 0;
        while (col < cols) {
            do setWall(0, col);
            do setWall(rows - 1, col);
            let col = col + 1;
        }

        let row = 0;
        while (row < rows) {
            do setWall(row, 0);
            do setWall(row, cols - 1);
            let row = row + 1;
        }
        return;
    }

    method void buildLevelOne() {
        do wallRow(3, 2, 9, 5);
        do wallRow(6, 1, 8, 3);
        do wallCol(7, 2, 8, 4);

        let startRow = 1;
        let startCol = 1;
        let enemyStartRow = 8;
        let enemyStartCol = 1;
        let goalRow = 8;
        let goalCol = 10;
        return;
    }

    method void buildLevelTwo() {
        do wallRow(2, 1, 9, 4);
        do wallRow(4, 3, 10, 8);
        do wallRow(6, 1, 8, 2);
        do wallCol(6, 2, 7, 5);

        let startRow = 8;
        let startCol = 1;
        let enemyStartRow = 8;
        let enemyStartCol = 10;
        let goalRow = 1;
        let goalCol = 10;
        return;
    }

    method void buildLevelThree() {
        do wallRow(2, 1, 9, 5);
        do wallRow(4, 2, 10, 9);
        do wallRow(6, 1, 8, 2);
        do wallCol(4, 2, 8, 7);
        do wallCol(8, 1, 7, 3);

        let startRow = 1;
        let startCol = 10;
        let enemyStartRow = 1;
        let enemyStartCol = 1;
        let goalRow = 8;
        let goalCol = 1;
        return;
    }

    method void wallRow(int row, int firstCol, int lastCol, int gapCol) {
        var int col;

        let col = firstCol;
        while (~(col > lastCol)) {
            if (~(col = gapCol)) {
                do setWall(row, col);
            }
            let col = col + 1;
        }
        return;
    }

    method void wallCol(int col, int firstRow, int lastRow, int gapRow) {
        var int row;

        let row = firstRow;
        while (~(row > lastRow)) {
            if (~(row = gapRow)) {
                do setWall(row, col);
            }
            let row = row + 1;
        }
        return;
    }

    method void setWall(int row, int col) {
        do setCell(row, col, 1);
        return;
    }

    method void setCell(int row, int col, int value) {
        var int index;
        let index = getIndex(row, col);
        let cells[index] = value;
        return;
    }

    method int getCell(int row, int col) {
        var int index;
        let index = getIndex(row, col);
        return cells[index];
    }

    method int getIndex(int row, int col) {
        return (row * cols) + col;
    }

    method boolean canEnter(int row, int col) {
        if (row < 0) {
            return false;
        }
        if (col < 0) {
            return false;
        }
        if (~(row < rows)) {
            return false;
        }
        if (~(col < cols)) {
            return false;
        }
        if (getCell(row, col) = 1) {
            return false;
        }
        return true;
    }

    method void draw() {
        var int row;
        var int col;
        var int x;
        var int y;
        var int index;
        var int value;

        let row = 0;
        let y = 42;
        let index = 0;
        while (row < rows) {
            let col = 0;
            let x = 10;
            while (col < cols) {
                let value = cells[index];

                if (value = 1) {
                    do Screen.setColor(true);
                    do Screen.drawRectangle(x, y, x + 13, y + 13);
                }

                if (value = 2) {
                    do Screen.setColor(true);
                    do Screen.drawRectangle(x + 4, y + 4, x + 9, y + 9);
                    do Screen.drawRectangle(x + 6, y + 1, x + 7, y + 12);
                    do Screen.drawRectangle(x + 1, y + 6, x + 12, y + 7);
                }

                let col = col + 1;
                let x = x + 16;
                let index = index + 1;
            }
            let row = row + 1;
            let y = y + 16;
        }
        return;
    }

    method int cellX(int col) {
        return 10 + (col * 16);
    }

    method int cellY(int row) {
        return 42 + (row * 16);
    }

    method int getRows() {
        return rows;
    }

    method int getCols() {
        return cols;
    }

    method int getCellCount() {
        return rows * cols;
    }

    method int getStartRow() {
        return startRow;
    }

    method int getStartCol() {
        return startCol;
    }

    method int getEnemyStartRow() {
        return enemyStartRow;
    }

    method int getEnemyStartCol() {
        return enemyStartCol;
    }

    method int getGoalRow() {
        return goalRow;
    }

    method int getGoalCol() {
        return goalCol;
    }

    method void dispose() {
        do cells.dispose();
        do Memory.deAlloc(this);
        return;
    }
}
