// Genera los 9 mapas del juego (3 modos x 3 niveles).
// Cada metodo mapaXY define muros, posiciones iniciales y galletas.
class GestorNiveles {
    constructor GestorNiveles new() { return this; }

    method void poblarLaberinto(Laberinto lab, int modo, int nivel) {
        if (modo = 1) { do construirEntrenamiento(lab, nivel); }
        if (modo = 2) { do construirNormal(lab, nivel); }
        if (modo = 3) { do construirExperto(lab, nivel); }
        return;
    }

    method void construirEntrenamiento(Laberinto lab, int nivel) {
        if (nivel = 1) { do mapaE1(lab); }
        if (nivel = 2) { do mapaE2(lab); }
        if (nivel = 3) { do mapaE3(lab); }
        return;
    }

    method void construirNormal(Laberinto lab, int nivel) {
        if (nivel = 1) { do mapaN1(lab); }
        if (nivel = 2) { do mapaN2(lab); }
        if (nivel = 3) { do mapaN3(lab); }
        return;
    }

    method void construirExperto(Laberinto lab, int nivel) {
        if (nivel = 1) { do mapaX1(lab); }
        if (nivel = 2) { do mapaX2(lab); }
        if (nivel = 3) { do mapaX3(lab); }
        return;
    }

    method void mapaE1(Laberinto lab) {
        do lab.reiniciar(11, 27);
        do lab.construirBorde();
        do lab.setMuro(2, 5); do lab.setMuro(2, 6); do lab.setMuro(3, 5); do lab.setMuro(3, 6);
        do lab.setMuro(2, 20); do lab.setMuro(2, 21); do lab.setMuro(3, 20); do lab.setMuro(3, 21);
        do lab.setMuro(7, 5); do lab.setMuro(7, 6); do lab.setMuro(8, 5); do lab.setMuro(8, 6);
        do lab.setMuro(7, 20); do lab.setMuro(7, 21); do lab.setMuro(8, 20); do lab.setMuro(8, 21);
        do lab.setInicio(1, 1);
        do lab.setEnemigoInicio(9, 25);
        do lab.setObjetivo(1, 25);
        do lab.setObjetivo(9, 1);
        do lab.setObjetivo(5, 13);
        return;
    }

    method void mapaE2(Laberinto lab) {
        do lab.reiniciar(11, 27);
        do lab.construirBorde();
        do lab.colMuro(13, 1, 4, -1);
        do lab.colMuro(13, 6, 9, -1);
        do lab.setInicio(1, 1);
        do lab.setEnemigoInicio(9, 25);
        do lab.setObjetivo(1, 25);
        do lab.setObjetivo(9, 1);
        do lab.setObjetivo(1, 12);
        do lab.setObjetivo(9, 14);
        return;
    }

    method void mapaE3(Laberinto lab) {
        do lab.reiniciar(13, 29);
        do lab.construirBorde();
        do lab.filaMuro(4, 4, 24, 14);
        do lab.filaMuro(8, 4, 24, 14);
        do lab.setInicio(1, 1);
        do lab.setEnemigoInicio(11, 27);
        do lab.setEnemigo2Inicio(1, 27);
        do lab.setObjetivo(1, 27);
        do lab.setObjetivo(11, 1);
        do lab.setObjetivo(6, 4);
        do lab.setObjetivo(6, 24);
        return;
    }

    method void mapaN1(Laberinto lab) {
        do lab.reiniciar(13, 29);
        do lab.construirBorde();
        do lab.filaMuro(3, 5, 23, -1);
        do lab.filaMuro(9, 5, 23, -1);
        do lab.colMuro(5, 3, 9, 6);
        do lab.colMuro(23, 3, 9, 6);
        do lab.setInicio(1, 1);
        do lab.setEnemigoInicio(11, 27);
        do lab.setEnemigo2Inicio(1, 27);
        do lab.setObjetivo(1, 27);
        do lab.setObjetivo(11, 1);
        do lab.setObjetivo(6, 5);
        do lab.setObjetivo(6, 23);
        do lab.setObjetivo(6, 14);
        return;
    }

    method void mapaN2(Laberinto lab) {
        do lab.reiniciar(13, 29);
        do lab.construirBorde();
        do lab.colMuro(7, 2, 5, -1); do lab.filaMuro(5, 2, 7, -1);
        do lab.colMuro(21, 2, 5, -1); do lab.filaMuro(5, 21, 26, -1);
        do lab.colMuro(7, 7, 10, -1); do lab.filaMuro(7, 2, 7, -1);
        do lab.colMuro(21, 7, 10, -1); do lab.filaMuro(7, 21, 26, -1);
        do lab.setInicio(1, 1);
        do lab.setEnemigoInicio(11, 27);
        do lab.setEnemigo2Inicio(1, 27);
        do lab.setObjetivo(1, 27);
        do lab.setObjetivo(11, 1);
        do lab.setObjetivo(6, 14);
        do lab.setObjetivo(1, 14);
        do lab.setObjetivo(11, 14);
        return;
    }

    method void mapaN3(Laberinto lab) {
        do lab.reiniciar(13, 31);
        do lab.construirBorde();
        do lab.filaMuro(2, 4, 12, -1); do lab.filaMuro(3, 4, 12, -1);
        do lab.filaMuro(2, 18, 26, -1); do lab.filaMuro(3, 18, 26, -1);
        do lab.filaMuro(9, 4, 12, -1); do lab.filaMuro(10, 4, 12, -1);
        do lab.filaMuro(9, 18, 26, -1); do lab.filaMuro(10, 18, 26, -1);
        do lab.colMuro(15, 2, 5, -1);
        do lab.colMuro(15, 7, 10, -1);
        do lab.setInicio(1, 1);
        do lab.setEnemigoInicio(11, 29);
        do lab.setEnemigo2Inicio(1, 29);
        do lab.setObjetivo(1, 29);
        do lab.setObjetivo(11, 1);
        do lab.setObjetivo(6, 1);
        do lab.setObjetivo(6, 29);
        do lab.setObjetivo(6, 14);
        do lab.setObjetivo(5, 14);
        do lab.setObjetivo(7, 14);
        return;
    }

    method void mapaX1(Laberinto lab) {
        do lab.reiniciar(13, 29);
        do lab.construirBorde();
        do lab.filaMuro(2, 2, 26, 14);
        do lab.filaMuro(10, 2, 26, 14);
        do lab.filaMuro(4, 2, 26, -1);
        do lab.reiniciarCelda(4, 7);
        do lab.reiniciarCelda(4, 21);
        do lab.filaMuro(8, 2, 26, -1);
        do lab.reiniciarCelda(8, 7);
        do lab.reiniciarCelda(8, 21);
        do lab.setInicio(1, 1);
        do lab.setEnemigoInicio(11, 27);
        do lab.setEnemigo2Inicio(1, 27);
        do lab.setObjetivo(1, 27);
        do lab.setObjetivo(11, 1);
        do lab.setObjetivo(6, 14);
        do lab.setObjetivo(1, 14);
        do lab.setObjetivo(11, 14);
        do lab.setObjetivo(6, 1);
        return;
    }

    method void mapaX2(Laberinto lab) {
        do lab.reiniciar(13, 31);
        do lab.construirBorde();
        do lab.colMuro(6, 1, 4, -1);
        do lab.colMuro(6, 8, 11, -1);
        do lab.colMuro(12, 1, 4, -1);
        do lab.colMuro(12, 8, 11, -1);
        do lab.colMuro(18, 1, 4, -1);
        do lab.colMuro(18, 8, 11, -1);
        do lab.colMuro(24, 1, 4, -1);
        do lab.colMuro(24, 8, 11, -1);
        do lab.filaMuro(6, 1, 29, 3);
        do lab.reiniciarCelda(6, 9);
        do lab.reiniciarCelda(6, 15);
        do lab.reiniciarCelda(6, 21);
        do lab.reiniciarCelda(6, 27);
        do lab.setInicio(1, 1);
        do lab.setEnemigoInicio(11, 29);
        do lab.setEnemigo2Inicio(1, 29);
        do lab.setObjetivo(1, 29);
        do lab.setObjetivo(11, 1);
        do lab.setObjetivo(1, 15);
        do lab.setObjetivo(11, 15);
        do lab.setObjetivo(6, 15);
        do lab.setObjetivo(6, 3);
        do lab.setObjetivo(6, 27);
        return;
    }

    method void mapaX3(Laberinto lab) {
        do lab.reiniciar(13, 31);
        do lab.construirBorde();
        do lab.colMuro(4, 1, 10, 5);
        do lab.colMuro(8, 2, 11, 6);
        do lab.colMuro(12, 1, 10, 5);
        do lab.colMuro(16, 2, 11, 6);
        do lab.colMuro(20, 1, 10, 5);
        do lab.colMuro(24, 2, 11, 6);
        do lab.colMuro(28, 1, 10, 5);
        do lab.setInicio(1, 1);
        do lab.setEnemigoInicio(11, 29);
        do lab.setEnemigo2Inicio(1, 29);
        do lab.setObjetivo(1, 29);
        do lab.setObjetivo(11, 1);
        do lab.setObjetivo(1, 15);
        do lab.setObjetivo(11, 15);
        do lab.setObjetivo(6, 3);
        do lab.setObjetivo(6, 11);
        do lab.setObjetivo(6, 19);
        do lab.setObjetivo(6, 27);
        return;
    }

    method void eliminar() {
        do Memory.deAlloc(this);
        return;
    }
}
