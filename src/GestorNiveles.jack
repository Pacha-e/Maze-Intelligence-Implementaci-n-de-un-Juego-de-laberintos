/** Generador de mapas. Cada nivel ocupa casi toda la pantalla del VM
 *  (limite efectivo 13 filas x 31 columnas en celdas de 16 px).
 *  Conectividad verificada manualmente para todos los objetivos.
 */
class GestorNiveles {
    constructor GestorNiveles new() { return this; }

    /** Construye el laberinto del nivel solicitado.
     *  Nivel 1 (11x27): un solo corte horizontal con dos camaras amplias.
     *  Nivel 2 (13x29): tres columnas con huecos verticales que generan zigzag.
     *  Nivel 3 (13x31): tres camaras horizontales con barreras internas.
     */
    method Laberinto crearLaberinto(int nivel) {
        var Laberinto lab;
        let lab = null;

        if (nivel = 1) {
            let lab = Laberinto.new(11, 27);
            do lab.construirBorde();
            // Corte horizontal central: solo el paso en col 13
            do lab.filaMuro(5, 1, 25, 13);
            // Barreras verticales suaves en cada camara, con hueco
            do lab.colMuro(13, 1, 3, 2);
            do lab.colMuro(13, 7, 9, 8);
            do lab.setInicio(1, 1);
            do lab.setEnemigoInicio(9, 25);
            do lab.setObjetivo(1, 25);
            do lab.setObjetivo(9, 1);
            do lab.setObjetivo(2, 13);
            do lab.setObjetivo(8, 13);
        }

        if (nivel = 2) {
            let lab = Laberinto.new(13, 29);
            do lab.construirBorde();
            // Tres columnas verticales con huecos alternados (zigzag)
            do lab.colMuro(8, 1, 6, 4);
            do lab.colMuro(16, 6, 11, 8);
            do lab.colMuro(24, 1, 6, 4);
            // Cortes horizontales que estrechan los corredores
            do lab.filaMuro(3, 9, 15, 12);
            do lab.filaMuro(9, 17, 23, 20);
            do lab.setInicio(1, 1);
            do lab.setEnemigoInicio(11, 27);
            do lab.setObjetivo(1, 27);
            do lab.setObjetivo(11, 1);
            do lab.setObjetivo(6, 14);
            do lab.setObjetivo(1, 14);
            do lab.setObjetivo(11, 14);
        }

        if (nivel = 3) {
            let lab = Laberinto.new(13, 31);
            do lab.construirBorde();
            // Dos lineas horizontales que separan tres camaras (hueco central)
            do lab.filaMuro(4, 1, 29, 15);
            do lab.filaMuro(9, 1, 29, 15);
            // Barreras verticales internas en cada camara con hueco propio
            do lab.colMuro(10, 1, 3, 2);
            do lab.colMuro(20, 1, 3, 2);
            do lab.colMuro(8, 5, 8, 6);
            do lab.colMuro(22, 5, 8, 6);
            do lab.colMuro(10, 10, 12, 11);
            do lab.colMuro(20, 10, 12, 11);
            do lab.setInicio(1, 1);
            do lab.setEnemigoInicio(11, 29);
            do lab.setObjetivo(1, 29);
            do lab.setObjetivo(3, 29);
            do lab.setObjetivo(6, 1);
            do lab.setObjetivo(6, 29);
            do lab.setObjetivo(11, 1);
            do lab.setObjetivo(3, 15);
            do lab.setObjetivo(8, 15);
        }

        return lab;
    }

    method void eliminar() {
        do Memory.deAlloc(this);
        return;
    }
}
